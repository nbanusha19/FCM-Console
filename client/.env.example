# Optional API base URL. Leave blank to use port 8000 on the same hostname
# serving the client (works for localhost and same-host LAN deployments).
# Set an explicit reachable HTTPS URL when the API is hosted elsewhere.
VITE_API_URL=

# Public HTTPS origin used in vendor links and printed QR codes.
VITE_PUBLIC_APP_URL=https://fcm.your-company.com
